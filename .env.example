# Environment variables for running CLI commands and scripts on the host
# pointing to Docker Compose services (via published host ports).
# Copy this file to .env:
#   cp .env.example .env

# MariaDB / MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=helio
MYSQL_PASSWORD=helio
MYSQL_DATABASE=heliotrope_development

# Solr
SOLR_URL=http://127.0.0.1:8983/solr/heliotrope-development

# Fedora / Fcrepo
FEDORA_URL=http://127.0.0.1:8080/rest

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
