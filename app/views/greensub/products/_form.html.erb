<%= simple_form_for @product do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :identifier, hint: 'A unique ID identifying the product' %>
  </div>

  <div class="form-inputs">
    <%= f.input :name %>
  </div>

  <div class="form-inputs">
    <%= f.input :purchase, label: 'Purchase URL' %>
  </div>

  <div class="form-inputs">
    <%= f.input :needs_kbart, as: :radio_buttons, collection: ['true', 'false'] %>
  </div>

  <div class="form-inputs">
    <%= f.input :group_key %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
