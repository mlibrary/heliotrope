<% provide :page_title, @title || "Title" %>
<%# https://github.com/mlibrary/heliotrope/issues/1228 %>
<% content_for :head do %>
  <meta name="turbolinks-cache-control" content="no-cache">

  <% if !@princesse_de_cleves && @parent_presenter.use_hypothesis? %>
    <script type="text/javascript">
      window.hypothesisConfig = function () {
        return {
          openSidebar: false,
          theme: 'clean', // "clean" or "classic"
          enableMultiFrameSupport: true,
          externalContainerSelector: '#hypothesis-panel',
          // The reader owns panel visibility. Hypothesis' open reports are only honoured
          // right after a click in the content (see hypothesisBridge.hypothesisLayoutChanged).
          onLayoutChange: function(state) {
            if (window.hypothesisBridge) {
              window.hypothesisBridge.hypothesisLayoutChanged(state);
            }
          },
          enableExperimentalNewNoteButton: true
        };
      };
    </script>
    <script src="https://cdn.hypothes.is/hypothesis"></script>
  <% end %>

  <%# This is a Princesse de Cleves EPUB thing %>
  <% if @map_file_presenter.present? %>
    <script type="text/javascript">
        var map_modal;

        var close_map = function() {
            if (map_modal) {
              map_modal.deactivate();
            }
        }

        var open_map = function() {
            if (map_modal) {
              map_modal.activate();
            }
        }
    </script>
  <% end %>
<% end %>

<% provide :body do %>
  <% if defined? @presenter.file_set_coins_title %>
    <span class="Z3988" title="<%= @presenter.file_set_coins_title %>" aria-hidden="true"></span>
  <% end %>

  <%= render partial: "e_pubs/survey_oa" %>

  <div class="skip"></div>
  <% if !@princesse_de_cleves && @parent_presenter.use_hypothesis? %>
    <button id="hypothesisProxyTrigger"
            data-hypothesis-trigger
            type="button"
            aria-hidden="true"
            tabindex="-1"
            style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;"></button>
    <span id="hypothesisAnnotationCount"
          data-hypothesis-annotation-count
          aria-hidden="true"
          style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;"></span>
  <% end %>
  <%# tag.div id: 'epub', class: press_presenter.present? ? press_presenter.press_subdomains : '' do %>
  <div class="too" id="epub">

    <div class="nm--toolbar">
      <div id="action-close" class="cozy-control">
        <a class="cozy-close cozy-control" href="<%= @parent_presenter.catalog_url %>" title="Close reader and return to previous page" aria-label="Close reader">
          <i class="icon-x oi" data-glyph="x" aria-hidden="true"></i>
        </a>
      </div>

      <button id="action-contents" data-toggle="open" class="button--sm" aria-label="Contents">
          <i class="icon-align-left oi" data-glyph="align-left" title="Table of Contents" aria-hidden="true"></i>
      </button>

      <button id="action-search" class="button--sm" data-toggle="open" aria-label="Search">
          <i class="icon-magnifying-glass oi" data-glyph="magnifying-glass" title="Search" aria-hidden="true"></i>
      </button>

    <% if @princesse_de_cleves %>
      <button id="action-notes" class="button--sm panel-closed" data-toggle="open" aria-label="Notes">
          <i class="icon-document oi" data-glyph="document" title="Notes and Definitions" aria-hidden="true"></i>
      </button>
    <% end %>

      <%# Right now this is a Princesse de Cleves thing, it won't be true except for PdC *plus* an interactive map %>
      <% if @map_file_presenter.present? %>
        <button id="action-map" class="cozy-control cozy-panel-map" onclick="open_map(); return false;" aria-label="Interactive Map">
          <i class="icon-map oi" data-glyph="map" aria-hidden="true" title="Accompanying Interactive Map"></i>
        </button>
      <% end %>

    <% if @monograph_assets_present %>
      <div id="action-resources" class="cozy-control cozy-panel-resources">
        <a class="cozy-control" href="<%= @parent_presenter.catalog_url + '#resources' %>" target="_blank" aria-label="Resources">
            <i class="icon-folder oi" data-glyph="folder" aria-hidden="true" title="Go to Resources page for this book (opens new window)"></i>
        </a>
      </div>
    <% end %>
      <button id="action-info" class="button--sm" data-toggle="open" aria-label="Info">
        <i class="icon-info oi" data-glyph="info" title="Book Information" aria-hidden="true"></i>
      </button>

      <button id="action-tts-help" class="button--sm" data-toggle="open" aria-label="Open Text-to-Speech Information">
        <i class="oi" data-glyph="volume-high" title="Open Text-to-Speech Information" aria-hidden="true"></i>
      </button>
    </div>

    <%# This is a Princesse de Cleves EPUB thing, obvs %>
    <div class="nm--panels" data-modal-activated="false">
      <% if !@princesse_de_cleves && @parent_presenter.use_hypothesis? %>
        <%# Hypothesis appends its sidebar iframe to this host; the header stays outside the iframe so the reader owns its title and close control. %>
        <div id="hypothesis-panel" class="hypothesis-panel" role="region" aria-labelledby="hypothesis-panel-title" aria-hidden="true">
          <header class="modal__header">
            <h3 id="hypothesis-panel-title" class="modal__title">Notes</h3>
            <button type="button"
                    class="modal__close"
                    aria-label="Close Notes"
                    aria-controls="hypothesis-panel"
                    onclick="window.hypothesisBridge.close(); return false;"></button>
          </header>
        </div>
      <% end %>
      <%= render "e_pubs/cozy_pdec_notes", presenter: @presenter, parent_presenter: @parent_presenter if @princesse_de_cleves %>
    </div>

    <div class="nm--reader" id="reader">
    </div>

    <script type="text/javascript">
        <% if !@princesse_de_cleves && @parent_presenter.use_hypothesis? %>
        // Hypothesis sidebar bridge. The public host API is feature-detected so this
        // remains compatible with the current proxy-trigger integration.
        var hypothesisBridge = window.hypothesisBridge = {
          annotationTool: null,
          layoutState: false,
          focusRequest: 0,
          hypothesisBootstrapped: false,
          contentDocuments: [],
          lastContentClick: 0,
          notesHint: null,
          notesHintLive: null,
          notesHintTimer: null,

          // Opening the panel resizes the reader and epub.js then re-renders every
          // content iframe, destroying the Hypothesis guest (and any unsaved draft
          // annotation) in it. So annotating is only offered while the panel is
          // already open: the selection menu is hidden in content documents otherwise.
          // Both readers behave the same way for consistency.
          watchContent: function(doc) {
            if (!doc || this.contentDocuments.indexOf(doc) !== -1) {
              return;
            }
            this.contentDocuments.push(doc);

            var css = 'html:not([data-hypothesis-panel-open]) hypothesis-adder { display: none !important; }';
            try {
              // Constructable stylesheets are not subject to inline-style CSP rules.
              var sheet = new doc.defaultView.CSSStyleSheet();
              sheet.replaceSync(css);
              doc.adoptedStyleSheets = Array.prototype.concat.call([], doc.adoptedStyleSheets, [sheet]);
            } catch (error) {
              var style = doc.createElement('style');
              style.textContent = css;
              (doc.head || doc.documentElement).appendChild(style);
            }
            this.syncContentDocuments();

            // Offer the hint when text is selected, remove it when the selection goes.
            var onSelectionEnd = function() {
              setTimeout(function() {
                var selection = doc.getSelection();
                if (selection && !selection.isCollapsed && selection.toString().trim()) {
                  this.showNotesHint();
                } else {
                  this.hideNotesHint();
                }
              }.bind(this), 0);
            }.bind(this);
            doc.addEventListener('mouseup', onSelectionEnd);
            doc.addEventListener('keyup', onSelectionEnd);

            // Clicking an existing annotation shows it in the sidebar, so reveal the panel.
            // There is no draft to lose here. Capture phase: runs before Hypothesis' own
            // handlers.
            doc.addEventListener('click', function(event) {
              this.lastContentClick = Date.now();
              var path = event.composedPath ? event.composedPath() : [event.target];
              var onHighlight = path.some(function(node) {
                return node && node.tagName && node.tagName.toLowerCase() === 'hypothesis-highlight';
              });
              if (onHighlight) {
                this.openFromHypothesis();
              }
            }.bind(this), true);
          },

          // Hypothesis hit-tests highlights by coordinates, so the click target is not
          // always a <hypothesis-highlight> element (notably in the PDF viewer). It does
          // always ask for the sidebar to open when a highlight is clicked, which arrives
          // here. Hypothesis also re-reports "open" on window resize, so only honour it
          // right after a click in the content.
          hypothesisLayoutChanged: function(state) {
            if (state && state.expanded && Date.now() - this.lastContentClick < 1000) {
              this.openFromHypothesis();
            }
          },

          // The selection menu is hidden while the panel is closed, so when text is
          // selected then, point at the toolbar button that opens the panel.
          showNotesHint: function() {
            var button = this.annotationButton();
            if (!button || this.layoutState) {
              return;
            }
            var rect = button.getBoundingClientRect();
            if (!rect.width) {
              return;
            }
            if (!this.notesHint) {
              this.notesHint = document.createElement('div');
              this.notesHint.className = 'hypothesis-notes-hint';
              this.notesHint.setAttribute('aria-hidden', 'true');
              this.notesHint.textContent = 'Open me to take notes';
              document.body.appendChild(this.notesHint);

              // The balloon is visual only; announce the same advice to screen readers.
              this.notesHintLive = document.createElement('div');
              this.notesHintLive.className = 'sr-only';
              this.notesHintLive.setAttribute('role', 'status');
              document.body.appendChild(this.notesHintLive);
            }
            this.notesHint.style.left = (rect.right + 12) + 'px';
            this.notesHint.style.top = (rect.top + rect.height / 2) + 'px';
            this.notesHint.classList.add('is-visible');
            this.notesHintLive.textContent = 'To take notes on the selected text, open the Notes panel.';
            clearTimeout(this.notesHintTimer);
            this.notesHintTimer = setTimeout(this.hideNotesHint.bind(this), 6000);
          },

          hideNotesHint: function() {
            clearTimeout(this.notesHintTimer);
            if (this.notesHint) {
              this.notesHint.classList.remove('is-visible');
            }
            if (this.notesHintLive) {
              this.notesHintLive.textContent = '';
            }
          },

          syncContentDocuments: function() {
            this.contentDocuments = this.contentDocuments.filter(function(doc) {
              return doc.defaultView;
            });
            this.contentDocuments.forEach(function(doc) {
              if (this.layoutState) {
                doc.documentElement.setAttribute('data-hypothesis-panel-open', '');
              } else {
                doc.documentElement.removeAttribute('data-hypothesis-panel-open');
              }
            }, this);
          },

          openFromHypothesis: function() {
            // Hypothesis is being used directly, so don't let the toolbar's proxy
            // trigger fire on the next open().
            this.hypothesisBootstrapped = true;
            if (!this.layoutState) {
              this.closeOtherModals();
              this.setPanelState(true, { focus: false });
            }
          },

          closeOtherModals: function() {
            // Use each modal's close button so its normal cleanup and focus handling run.
            document.querySelectorAll('.cozy-modal[aria-hidden="false"] button[data-modal-close]').forEach(function(button) {
              button.click();
            });
          },

          installPanelOrchestrator: function() {
            var observerRoot = document.body;
            if (!observerRoot || typeof MutationObserver === 'undefined') {
              return;
            }
            // Cozy modals and the Hypothesis panel share one reader column; keep them mutually exclusive.
            this.modalObserver = new MutationObserver(function() {
              var hypothesisPanel = document.querySelector('#hypothesis-panel');
              var hypothesisOpen = this.layoutState || (hypothesisPanel && hypothesisPanel.getAttribute('aria-hidden') === 'false');
              if (hypothesisOpen && document.querySelector('.cozy-modal[aria-hidden="false"]')) {
                this.close();
              }
            }.bind(this));
            this.modalObserver.observe(observerRoot, {
              subtree: true,
              attributes: true,
              attributeFilter: ['aria-hidden']
            });
          },

          annotationButton: function() {
            if (!this.annotationTool || !this.annotationTool.getContainer()) {
              return null;
            }
            return this.annotationTool.getContainer().querySelector('button');
          },

          annotationCount: function() {
            if (!this.annotationTool || !this.annotationTool.getContainer()) {
              return null;
            }
            return this.annotationTool.getContainer().querySelector('[data-hypothesis-annotation-count]');
          },

          attachAnnotationTool: function(annotationTool) {
            this.annotationTool = annotationTool;
            annotationTool.state(this.layoutState ? 'open-annotator' : 'close-annotator');
            var toolbarCount = this.annotationCount();
            var initialCount = document.getElementById('hypothesisAnnotationCount');
            if (toolbarCount && initialCount) {
              toolbarCount.textContent = initialCount.textContent;
            }
          },

          setPanelState: function(open, options) {
            var moveFocus = !(options && options.focus === false);
            var hypothesisPanel = document.querySelector('#hypothesis-panel');
            var panels = document.querySelector('.nm--panels');
            var readerContainer = document.querySelector('#epub.too');
            var otherModalOpen = panels && panels.querySelector('.cozy-modal[aria-hidden="false"]');
            if (!hypothesisPanel) {
              return false;
            }

            var changed = this.layoutState !== open;
            this.layoutState = open;
            hypothesisPanel.setAttribute('aria-hidden', open ? 'false' : 'true');
            this.syncContentDocuments();
            if (open) {
              this.hideNotesHint();
            }
            if (panels && (open || !otherModalOpen)) {
              panels.setAttribute('data-modal-activated', open ? 'true' : 'false');
              if (readerContainer) {
                readerContainer.classList.toggle('panels-open', open);
                // epub.js only re-measures on a window resize. Cozy modals dispatch one
                // from Modal._setPanelState; do the same here, otherwise the book keeps
                // its old width after the panel opens or closes. Repeat after the next
                // frame so we measure the settled grid layout.
                window.dispatchEvent(new Event('resize'));
                requestAnimationFrame(function() {
                  window.dispatchEvent(new Event('resize'));
                });
              }
            }
            if (changed && this.annotationTool) {
              this.annotationTool.state(open ? 'open-annotator' : 'close-annotator');
            }
            if (open) {
              // Ignore a queued focus callback from an earlier open/close transition.
              var focusRequest = ++this.focusRequest;
              var button = this.annotationButton();
              if (button && moveFocus) {
                requestAnimationFrame(function() {
                  if (focusRequest === this.focusRequest && this.layoutState && button.isConnected) {
                    button.focus();
                  }
                }.bind(this));
              }
            } else {
              this.focusRequest++;
            }
            return true;
          },

          open: function() {
            this.closeOtherModals();
            this.setPanelState(true);
            if (!this.hypothesisBootstrapped) {
              var proxy = document.getElementById('hypothesisProxyTrigger');
              if (proxy) {
                this.hypothesisBootstrapped = true;
                proxy.click();
              }
            }
            return true;
          },

          close: function() {
            return this.setPanelState(false);
          }
        };

        // hypothes.is integration
        var AnnotationTool = cozy.Control.Widget.Toggle.extend({
          defaultTemplate: '<button class="button--sm annotation" data-toggle="button" aria-label="Open Annotations"><i class="fa fa-pencil" title="Open annotation panel" aria-hidden="true"></i><span class="annotation-count" data-hypothesis-annotation-count></span></button>',


          initialize: function(options) {

            cozy.Control.Widget.Toggle.prototype.initialize.apply(this, arguments);

            this.options.states = [{
              stateName: 'close-annotator',
              onClick: this.openAnnotator.bind(this)
            },
              {
                stateName: 'open-annotator',
                className: 'reader-panel-active',
                onClick: this.closeAnnotator.bind(this)
              }];
          },

          _onAddExtra: function(container) {
            // super._onAddExtra(container);
            cozy.Control.Widget.Toggle.prototype._onAddExtra.apply(this, arguments);
            this.setupHook();
            return container;
          },

          openAnnotator: function(self, reader) {
            hypothesisBridge.open();
            self.state('open-annotator');
          },

          closeAnnotator: function(self, reader) {
            hypothesisBridge.close();
            self.state('close-annotator');
          },

          setupHook: function() {
            var reader = this._reader;
            reader.rendition.hooks.content.register(function(contents, view) {
              hypothesisBridge.watchContent(contents.document);
              contents.window.addEventListener('scrolltorange', function (e) {
                var range = e.detail;
                var cfi = new reader.CFI(range, contents.cfiBase).toString();
                if (cfi) {
                  reader.gotoPage(cfi);
                }
                e.preventDefault();
              });
            });

            // The hook above only runs for sections rendered after registration; catch
            // any section that is already on screen.
            try {
              reader.rendition.getContents().forEach(function(contents) {
                hypothesisBridge.watchContent(contents.document);
              });
            } catch (error) {
              // getContents() is unavailable until a section has been rendered.
            }
          }
        });
        <% end %>
        // Configure and initiate reader
        var reader = cozy.reader('reader', {
          href: "<%= "#{main_app.epub_url.gsub!(/\?.*/, '')}/" %>",
          skipLink: '.skip',
          download_links: <%= @ebook_download_presenter.csb_download_links.to_json.html_safe %>,
          loader_template: '<div class="fulcrum-loading"><div class="rect rect1"></div><div class="circle circ1"></div><div class="rect rect2"></div><div class="circle circ2"></div></div>',
          <% if %w[leverpress michigan mps uncpress].include? @subdomain %>
          injectStylesheet: '/assets/css/fulcrum_enhanced_display.css',
          <% end %>
          metadata: {
            doi: '<%= @citable_link %>',
            location: 'Ann Arbor, MI'
          }
        });
        <% if @map_file_presenter.present? %>
        map_modal = reader.modal({
          region: 'full',
          title: 'Accompanying Interactive Map for <i>La Princesse de Clèves</i>',
          fraction: 1.0,
          template: '<div style="height: 100%; width: 100%"><iframe title="Accompanying Interactive Map for La Princesse de Cleves" style="width: 100%; height: 100%;" src="<%= @map_file_presenter %>"></iframe></div>'
        });
        <% end %>
        var controls = {};
        var moveControlToToolbar = function(control) {
          document.querySelector('.nm--toolbar').appendChild(control.getContainer());
          return control;
        };

        <%= render partial: "e_pubs/cozy_controls_top", formats: [:js], presenter: @presenter, parent_presenter: @parent_presenter %>

        <%= render partial: "e_pubs/cozy_controls_bottom", formats: [:js], presenter: @presenter, parent_presenter: @parent_presenter %>

        <% if !@princesse_de_cleves && @parent_presenter.use_hypothesis? %>
          function addAnnotationTool() {
            var annotation_tool = new AnnotationTool({
              region: 'top.toolbar.left',
              $panel: $('.annotator-frame')
            });
            annotation_tool.addTo(reader);
            moveControlToToolbar(annotation_tool);
            hypothesisBridge.attachAnnotationTool(annotation_tool);
          }

          function checkForAnnotator() {
            if (reader.rendition) {
              addAnnotationTool();
            } else {
              setTimeout(checkForAnnotator, 100);
            }
          }

          checkForAnnotator();
          hypothesisBridge.installPanelOrchestrator();
        <% end %>

      <% if @princesse_de_cleves %>
        <%= render partial: "e_pubs/cozy_controls_notes", formats: [:js], presenter: @presenter, parent_presenter: @parent_presenter %>

        <%= render partial: "e_pubs/cozy_controls_tools", formats: [:js], presenter: @presenter, parent_presenter: @parent_presenter %>

        function runFrenchCheckbox(frenchCheckbox, frenchTexts) {
          console.log("-- runFrenchCheckbox");
          if (frenchCheckbox !== null && frenchCheckbox.checked) {
            if (frenchTexts !== null) {
              for(var i =0, n = frenchTexts.length; i < n; i++) {
                var frenchText = frenchTexts[i];
                frenchText.classList.remove('hide');
                frenchText.classList.add('display');
              }
            }
          } else {
            if (frenchTexts !== null) {
              for(var i =0, n = frenchTexts.length; i < n; i++) {
                var frenchText = frenchTexts[i];
                frenchText.classList.remove('display');
                frenchText.classList.add('hide');
              }
            }
          }
        }

        function runEnglishCheckbox(englishCheckbox, englishTexts) {
          console.log("-- runEnglishCheckbox");
          if (englishCheckbox && englishCheckbox.checked) {
            if (englishTexts !== null) {
              for(var i =0, n = englishTexts.length; i < n; i++) {
                var englishText = englishTexts[i];
                englishText.classList.remove('hide');
                englishText.classList.add('display');
              }
            }
          } else {
            if (englishTexts !== null) {
              for(var i =0, n = englishTexts.length; i < n; i++) {
                var englishText = englishTexts[i];
                englishText.classList.remove('display');
                englishText.classList.add('hide');
              }
            }
          }
        }

        function runTermsCheckbox(termsCheckbox, terms) {
          console.log("-- runTermsCheckbox");
          if (termsCheckbox && termsCheckbox.checked) {
            if (terms !== null) {
              for (let i =0, n = terms.length; i < n; i++) {
                let term = terms[i];
                term.classList.add('highlight');
              }
            }
          } else {
            if (terms !== null) {
              for (let i =0, n = terms.length; i < n; i++) {
                let term = terms[i];
                term.classList.remove('highlight');
              }
            }
          }
        }

        function runKeywordsCheckbox(keywordsCheckbox, keywords) {
          console.log("-- runKeywordsCheckbox");
          if (keywordsCheckbox && keywordsCheckbox.checked) {
            if (keywords !== null) {
              for (var i =0, n = keywords.length; i < n; i++) {
                var keyword = keywords[i];
                keyword.classList.add('highlight');
              }
            }
          } else {
            if (keywords !== null) {
              for (var i =0, n = keywords.length; i < n; i++) {
                var keyword = keywords[i];
                keyword.classList.remove('highlight');
              }
            }
          }
        }

        reader.on('ready:contents', function(contents) {
          console.log('-- ready:contents');
          // find note links in EPUB
          var note_links = contents.content.querySelectorAll("a[data-note-ref]");
            for(let i =0, n = note_links.length; i < n; i++) {
              let note_link = note_links[i];
              note_link.addEventListener('click', click_handler);                
            }
          // find map links in EPUB
          var map_links = contents.content.querySelectorAll(".pdec_location");
            for(let i =0, n = map_links.length; i < n; i++) {
              let map_link = map_links[i];
              map_link.addEventListener('click', mapClick_handler);                
            }
          // french / english version display 
          var frenchTexts =  contents.document.querySelectorAll(".french");
          var frenchCheckbox = document.querySelector('#french');

          runFrenchCheckbox(frenchCheckbox, frenchTexts);
          if (frenchCheckbox) {
            frenchCheckbox.addEventListener('change', () => {
              runFrenchCheckbox(frenchCheckbox, frenchTexts);
            });
          }

          var englishTexts =  contents.document.querySelectorAll(".english");
          var englishCheckbox = document.querySelector('#english');

          runEnglishCheckbox(englishCheckbox, englishTexts);
          if (englishCheckbox) {
            englishCheckbox.addEventListener('change', () => {
              runEnglishCheckbox(englishCheckbox, englishTexts);
            });
          }
          // text tools
          var terms = contents.document.querySelectorAll(".FrequentlyUsedTerm", ".FrequentlyUsedTermTermwDefinition"); 
          var termsCheckbox = document.querySelector('#terms');

          runTermsCheckbox(termsCheckbox, terms);
          if (termsCheckbox) {
            termsCheckbox.addEventListener('change', () => {
              runTermsCheckbox(termsCheckbox, terms);
            });
          }

          var keywords = contents.document.querySelectorAll(".LexicalDossierLink");
          var keywordsCheckbox = document.querySelector('#keywords');

          runKeywordsCheckbox(keywordsCheckbox, keywords);
          if (keywordsCheckbox) {
            keywordsCheckbox.addEventListener('change', () => {
              runKeywordsCheckbox(keywordsCheckbox, keywords);
            });
          }
        });


      <% end %> <%# if @princesse_de_cleves %>


        moveControlToToolbar(cozy.control.widget.button({
          region: 'bottom.navigator.right',
          className: 'cozy-panel-feedback',
          template: '<a class="button--sm" id="action-help" href="https://umich.qualtrics.com/jfe/form/SV_3KSLynPij0fqrD7?publisher=&url=" target="_blank" title="Report a problem or share feedback" aria-label="Report a problem or share feedback"><i class="icon-question-mark oi" data-glyph="question-mark" aria-hidden="true"></i></a>',
        }).addTo(reader));

        // Initiate EPUB Reader
        reader.start(function () {
          console.log('-- started');
