<% riiif_url = "/image-service/#{file_set.id}#{file_set.browser_cache_breaker}/info.json" %>
<div id="image" style="height:100%;" class="no-context-menu-or-drag"></div>
<script>
  var map, layer, timer, rotateBtn;
  var currentAngle = 0; // Tracking variable for continuous clockwise incrementation

  $(document).ready(function() {
    throttleLeafletMapSetup(500);
  });

  $(window).resize(function() {
    throttleLeafletMapSetup(250);
  });

  function throttleLeafletMapSetup(milliseconds) {
    clearTimeout (timer);
    timer = setTimeout(setupLeafletMap, milliseconds);
  }

  // Advanced precision pivot rotation applicator
  function applyRotation(angle) {
    var mapDiv = document.getElementById('image');
    if (!mapDiv || !map) return;

    var tilePane = mapDiv.querySelector('.leaflet-tile-pane');
    var overlayPane = mapDiv.querySelector('.leaflet-overlay-pane');
    var visuallyNormalizedAngle = angle % 360;

    // FIX: Find the center point of the physical screen viewport frame
    var viewCenterWidth = mapDiv.offsetWidth / 2;
    var viewCenterHeight = mapDiv.offsetHeight / 2;

    // Extract Leaflet's internal dragging/panning pixel offset translations
    var paneOffset = typeof map._getMapPanePos === 'function' ? map._getMapPanePos() : { x: 0, y: 0 };

    // Calculate the exact pivot vector point relative to the shifting pane coordinates
    var pivotX = viewCenterWidth - paneOffset.x;
    var pivotY = viewCenterHeight - paneOffset.y;

    [tilePane, overlayPane].forEach(function(pane) {
      if (pane) {
        if (visuallyNormalizedAngle === 0) {
          pane.style.transform = 'none';
          pane.style.transformOrigin = 'center center';
        } else {
          // Force the transformation origin pivot to latch exactly onto the viewport center coordinates
          pane.style.transformOrigin = pivotX + 'px ' + pivotY + 'px';
          pane.style.transform = 'rotate(' + visuallyNormalizedAngle + 'deg)';
        }
      }
    });

    // Recalculate sizes cleanly across layout scales
    setTimeout(function() {
      if (map && typeof map.invalidateSize === 'function') {
        map.invalidateSize();
      }
    }, 100);
  }

  function setupLeafletMap() {
    if (map != undefined) { map.off(); map.remove(); }
    map = L.map('image', {
      center: [0, 0],
      crs: L.CRS.Simple,
      zoom: 0,
      scrollWheelZoom: false,
      <% if params[:fs] == '1' && file_set.allow_high_res_display? %>
      fullscreenControl: true,
      fullscreenControlOptions: {
        title:"View in fullscreen mode",
        titleCancel:"Exit fullscreen mode"
      },
      <% end %>
      attributionControl: false
    });
    layer = L.tileLayer.iiif("<%= riiif_url %>", { bestFit: true });
    layer.addTo(map);
    L.control.pan({ panOffset: 150 }).addTo(map);

    // Instantly force state synchronization upon map destruction-recovery cycles
    if (currentAngle !== 0) {
      applyRotation(currentAngle);
    }

    // Handle re-aligning the custom pivot vector calculations whenever the user drags or pans the image
    map.on('moveend zoomend', function() {
      if (currentAngle !== 0) {
        applyRotation(currentAngle);
      }
    });

    // Initialize custom button inside zoom panel
    setTimeout(function() {
      var controlBar = document.querySelector('.leaflet-control-zoom');

      if (controlBar) {
        rotateBtn = L.DomUtil.create('a', 'leaflet-control-rotate', controlBar);
        rotateBtn.innerHTML = '<i class="icon-reload oi" data-glyph="reload"></i>';
        rotateBtn.href = '#';
        rotateBtn.title = 'Rotate 90° Clockwise';
        rotateBtn.setAttribute('role', 'button');
        rotateBtn.setAttribute('aria-label', 'Rotate 90 degrees clockwise');

        L.DomEvent.disableClickPropagation(rotateBtn);

        if (map.isFullscreen && map.isFullscreen()) {
          rotateBtn.classList.add('fullscreen-hidden');
        }

        L.DomEvent.on(rotateBtn, 'click', function (e) {
          L.DomEvent.stop(e);
          currentAngle += 90;
          applyRotation(currentAngle);
        });
      }
    }, 200);

    // Native Fullscreen lifecycle configurations
    map.on('enterFullscreen', function() {
      if (rotateBtn) {
        rotateBtn.classList.add('fullscreen-hidden');
      }
      applyRotation(0);
      setTimeout(function() {
        try { layer._fitBounds(); } catch (err) {}
      }, 250);
    });

    map.on('exitFullscreen', function() {
      if (rotateBtn) {
        rotateBtn.classList.remove('fullscreen-hidden');
      }
      setTimeout(function() {
        try { layer._fitBounds(); } catch (err) {}
        applyRotation(currentAngle);
      }, 250);
    });
  }
</script>
